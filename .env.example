VBRIDGE_APP_NAME=VBridge API
VBRIDGE_API_HOST=0.0.0.0
VBRIDGE_API_PORT=8000
VBRIDGE_CORS_ORIGINS=http://localhost:5173
VBRIDGE_AUDIO_OUTPUT_DIR=/tmp/vbridge-audio
VITE_API_URL=http://localhost:8000
# Mock defaults start without model downloads.
VBRIDGE_INFERENCE_BACKEND=cpu
VBRIDGE_ASR_MODE=mock
VBRIDGE_ASR_MODEL=Systran/faster-whisper-base
VBRIDGE_MT_MODE=mock
VBRIDGE_MT_MODEL=facebook/nllb-200-distilled-600M
VBRIDGE_TTS_MODE=mock
VBRIDGE_TTS_VOICE=default
VBRIDGE_GLOSSARY_PATH=docs/referrences/glossary.csv
VBRIDGE_VAD_MODE=silero
VBRIDGE_VAD_THRESHOLD=0.3
VBRIDGE_VAD_MIN_SILENCE_MS=500
VBRIDGE_PARTIAL_INTERVAL_CHUNKS=12
